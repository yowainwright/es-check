      "!lib/**",
      "!src/**",
      "lib/index.js",
      "lib/*/{index,constants,utils}.js",
      "!lib/helpers/**",
      "lib/core/{index,browserslist,checkRunner,detectFeatures,browserSupport,files,logger,parsers,sourcemap}.js",
      "lib/core/esm.mjs",
      "!lib/core/ast/**",
      "lib/core/ast/{index,constants,utils}.js",
      "lib/core/ast/detector/{index,utils}.js",
      "!lib/check-runner/**",
      "!lib/browserslist/**",
      "!lib/constants/**",
      "lib/constants/index.js",
      "lib/constants/{es,browserslist,polyfills}/index.js",
      "lib/constants/browserslist/constants.js",
      "lib/constants/browserslist/support/index.js",
      "lib/constants/es/{2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027}/index.js",
      "!tests/unit/browserslist/**",
      "!tests/unit/check-runner/**",
