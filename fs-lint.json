      "tests/unit/core/ast/{index,constants,utils}.test.js",
      "tests/unit/core/ast/detector/{index,utils}.test.js",
      "!tests/unit/cli/**",
      "tests/unit/cli/{index,constants,utils}.test.js",
      "!tests/unit/constants/**",
      "tests/unit/constants/index.test.js",
      "tests/unit/constants/{es,browserslist,polyfills}/index.test.js",
      "tests/unit/constants/browserslist/constants.test.js",
      "tests/unit/constants/browserslist/support/index.test.js",
      "tests/unit/constants/es/{2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027}/index.test.js"
    ]
  }
}
