{
  "name": "es-check",
  "version": "9.7.0",
  "description": "Checks the ECMAScript version of .js glob against a specified version of ECMAScript with a shell command",
  "keywords": [
    "check for es6",
    "check for modules",
    "ecmascript",
    "ecmascript check",
    "ecmascript matching",
    "ecmascript version",
    "es",
    "es check",
    "es matching",
    "es version",
    "js",
    "js version",
    "js version check",
    "js version matching",
    "test ecmascript version",
    "test js version"
  ],
  "homepage": "https://github.com/yowainwright/es-check#readme",
  "bugs": {
    "url": "https://github.com/yowainwright/es-check/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in), Brian Gonzalez <me@briangonzalez.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/es-check.git"
  },
  "bin": {
    "es-check": "lib/cli/index.js"
  },
  "workspaces": [
    "site"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/esm-wrapper.mjs",
      "require": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "pnpm site:dev",
    "lint": "oxlint -c .oxlintrc.json lib --deny-warnings",
    "lint:ci": "oxlint -c .oxlintrc.json lib --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pastoralist": "pastoralist",
    "pre-commit": "pnpm lint && pnpm format && pnpm test",
    "prepare": "node scripts/install/hooks.mjs",
    "prepublishOnly": "pnpm test",
    "release": "release-it --no-git.requireUpstream",
    "release:patch": "release-it --increment=patch --no-git.requireUpstream",
    "release:patch:dry": "release-it --increment=patch --dry-run --no-git.requireUpstream",
    "release:minor": "release-it --increment=minor --no-git.requireUpstream",
    "release:minor:dry": "release-it --increment=minor --dry-run --no-git.requireUpstream",
    "release:major": "release-it --increment=major --no-git.requireUpstream",
    "release:major:dry": "release-it --increment=major --dry-run --no-git.requireUpstream",
    "release:beta": "release-it --preRelease=beta --no-git.requireUpstream",
    "release:beta:dry": "release-it --preRelease=beta --dry-run --no-git.requireUpstream",
    "release:alpha": "release-it --preRelease=alpha --no-git.requireUpstream",
    "release:alpha:dry": "release-it --preRelease=alpha --dry-run --no-git.requireUpstream",
    "release:tag": "node scripts/release-tag.mjs",
    "release:tag:dry": "node scripts/release-tag.mjs --dry-run",
    "release:dry": "release-it --dry-run --no-git.requireUpstream",
    "report:coverage": "mkdir -p coverage && node tests/scripts/test-runner.js unit --coverage --reporter=lcov --reporter-destination=coverage/lcov.info",
    "scripts:generate": "pnpm run scripts:generate:requirements && pnpm run scripts:generate:polyfills",
    "scripts:generate:requirements": "node scripts/generate/requirements/parser.mjs",
    "scripts:generate:polyfills": "node scripts/generate/polyfills/core.mjs",
    "test": "node tests/scripts/test-runner.js unit && npm run test:e2e",
    "test:unit": "node tests/scripts/test-runner.js unit",
    "test:unit:verbose": "node tests/scripts/test-runner.js unit --verbose",
    "test:e2e": "npm run test:e2e:cli && npm run test:e2e:esm && npm run test:e2e:package-files && npm run test:e2e:sourcemap",
    "test:e2e:typescript": "tests/e2e/typescript/run-tests.sh",
    "test:e2e:cli": "node tests/e2e/test-cli.js",
    "test:e2e:esm": "node tests/e2e/test-esm-import.mjs",
    "test:e2e:package-files": "node tests/e2e/test-package-files.mjs",
    "test:e2e:sourcemap": "node --test --test-timeout=10000 tests/e2e/test-sourcemap.js",
    "update": "codependence --update && pastoralist && pnpm run scripts:generate",
    "benchmark": "./tests/benchmarks/run-benchmarks.sh",
    "site:dev": "pnpm --filter es-check-docs run dev",
    "site:build": "pnpm --filter es-check-docs run build",
    "site:preview": "pnpm --filter es-check-docs run preview",
    "site:install": "pnpm --filter es-check-docs install"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "browserslist": "4.28.9",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.0",
    "codependence": "1.0.15",
    "core-js-compat": "^3.50.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "pastoralist": "1.13.2",
    "release-it": "21.0.2"
  },
  "peerDependencies": {},
  "optionalDependencies": {},
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "12.3.4",
        "onFail": "download"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "codependence": {
    "mode": "precise",
    "files": [
      "package.json",
      "site/package.json"
    ]
  },
  "pastoralist": {
    "depPaths": [
      "package.json",
      "site/package.json"
    ],
    "security": {
      "enabled": true,
      "provider": "github",
      "autoFix": true,
      "interactive": false,
      "severityThreshold": "low",
      "hasWorkspaceSecurityChecks": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "pnpm run lint",
        "pnpm test"
      ],
      "after:release": "echo Successfully released ${name} v${version} to ${repo.repository}."
    }
  },
  "website": "https://jeffry.in/es-check"
}
