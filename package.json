{
  "name": "es-check",
  "version": "9.6.4",
  "description": "Checks the ECMAScript version of .js glob against a specified version of ECMAScript with a shell command",
  "keywords": [
    "check for es6",
    "check for modules",
    "ecmascript",
    "ecmascript check",
    "ecmascript matching",
    "ecmascript version",
    "es",
    "es check",
    "es matching",
    "es version",
    "js",
    "js version",
    "js version check",
    "js version matching",
    "test ecmascript version",
    "test js version"
  ],
  "homepage": "https://github.com/yowainwright/es-check#readme",
  "bugs": {
    "url": "https://github.com/yowainwright/es-check/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in), Brian Gonzalez <me@briangonzalez.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/es-check.git"
  },
  "bin": {
    "es-check": "lib/cli/index.js"
  },
  "workspaces": [
    "site"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/esm-wrapper.mjs",
      "require": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "pnpm site:dev",
    "lint": "oxlint -c .oxlintrc.json lib",
    "lint:ci": "oxlint -c .oxlintrc.json lib --quiet",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pastoralist": "pastoralist",
    "pre-commit": "pnpm lint && pnpm format && pnpm test",
    "prepare": "node scripts/install/hooks.mjs",
    "prepublishOnly": "pnpm test",
    "release": "release-it --no-git.requireUpstream",
    "release:patch": "release-it --increment=patch --no-git.requireUpstream",
    "release:patch:dry": "release-it --increment=patch --dry-run --no-git.requireUpstream",
    "release:minor": "release-it --increment=minor --no-git.requireUpstream",
    "release:minor:dry": "release-it --increment=minor --dry-run --no-git.requireUpstream",
    "release:major": "release-it --increment=major --no-git.requireUpstream",
    "release:major:dry": "release-it --increment=major --dry-run --no-git.requireUpstream",
    "release:beta": "release-it --preRelease=beta --no-git.requireUpstream",
    "release:beta:dry": "release-it --preRelease=beta --dry-run --no-git.requireUpstream",
    "release:alpha": "release-it --preRelease=alpha --no-git.requireUpstream",
    "release:alpha:dry": "release-it --preRelease=alpha --dry-run --no-git.requireUpstream",
    "release:tag": "node scripts/release-tag.mjs",
    "release:tag:dry": "node scripts/release-tag.mjs --dry-run",
    "release:dry": "release-it --dry-run --no-git.requireUpstream",
    "report:coverage": "mkdir -p coverage && node tests/scripts/test-runner.js unit --coverage --reporter=lcov --reporter-destination=coverage/lcov.info",
    "scripts:generate": "pnpm run scripts:generate:requirements && pnpm run scripts:generate:polyfills",
    "scripts:generate:requirements": "node scripts/generate/requirements/parser.mjs",
    "scripts:generate:polyfills": "node scripts/generate/polyfills/core.mjs",
    "test": "node tests/scripts/test-runner.js unit && npm run test:e2e",
    "test:unit": "node tests/scripts/test-runner.js unit",
    "test:unit:verbose": "node tests/scripts/test-runner.js unit --verbose",
    "test:e2e": "npm run test:e2e:cli && npm run test:e2e:esm && npm run test:e2e:package-files && npm run test:e2e:sourcemap",
    "test:e2e:typescript": "tests/e2e/typescript/run-tests.sh",
    "test:e2e:cli": "node tests/e2e/test-cli.js",
    "test:e2e:esm": "node tests/e2e/test-esm-import.mjs",
    "test:e2e:package-files": "node tests/e2e/test-package-files.mjs",
    "test:e2e:sourcemap": "node --test --test-timeout=10000 tests/e2e/test-sourcemap.js",
    "update": "codependence --update && pastoralist && pnpm run scripts:generate",
    "benchmark": "./tests/benchmarks/run-benchmarks.sh",
    "site:dev": "pnpm --filter es-check-docs run dev",
    "site:build": "pnpm --filter es-check-docs run build",
    "site:preview": "pnpm --filter es-check-docs run preview",
    "site:install": "pnpm --filter es-check-docs install"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^7.3.3",
    "browserslist": "^4.28.1",
    "codependence": "1.0.7",
    "core-js-compat": "^3.48.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.49.0",
    "pastoralist": "1.10.0-1",
    "release-it": "21.0.1"
  },
  "peerDependencies": {},
  "optionalDependencies": {},
  "overrides": {
    "ajv": "8.18.0",
    "devalue": "5.6.3",
    "diff": "5.2.2",
    "js-yaml": "4.1.1",
    "lodash": "4.17.23",
    "mdast-util-to-hast": "13.2.1",
    "tmp": "0.2.4",
    "undici": "6.23.0",
    "vite": "6.4.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.0",
  "pastoralist": {
    "appendix": {
      "vite@6.4.1": {
        "dependents": {
          "es-check": "vite (transitive dependency)",
          "es-check-docs": "vite@^7.3.0"
        },
        "ledger": {
          "addedDate": "2026-01-12T05:15:47.989Z"
        }
      },
      "tmp@0.2.4": {
        "dependents": {
          "es-check": "tmp (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-01-12T05:15:47.989Z"
        }
      },
      "js-yaml@4.1.1": {
        "dependents": {
          "es-check": "js-yaml (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-01-12T05:15:47.989Z"
        }
      },
      "mdast-util-to-hast@13.2.1": {
        "dependents": {
          "es-check": "mdast-util-to-hast (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-01-12T05:15:47.989Z"
        }
      },
      "undici@6.23.0": {
        "dependents": {
          "es-check": "undici (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-01-17T00:15:11.438Z",
          "reason": "Security fix: Undici has an unbounded decompression chain in HTTP responses on Node.js Fetch API via Content-Encoding leads to resource exhaustion (low)",
          "securityChecked": true,
          "securityCheckDate": "2026-01-17T00:15:11.438Z",
          "securityProvider": "github",
          "cve": "CVE-2026-22036",
          "severity": "low",
          "url": "https://github.com/yowainwright/es-check/security/dependabot/57"
        }
      },
      "devalue@5.6.3": {
        "dependents": {
          "es-check": "devalue (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-02-21T00:23:12.264Z",
          "reason": "Security fix: devalue `uneval`ed code can create objects with polluted prototypes when `eval`ed (low)",
          "securityChecked": true,
          "securityCheckDate": "2026-02-21T00:23:12.264Z",
          "securityProvider": "github",
          "severity": "low",
          "url": "https://github.com/yowainwright/es-check/security/dependabot/66"
        }
      },
      "lodash@4.17.23": {
        "dependents": {
          "es-check": "lodash (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-02-21T00:23:12.264Z",
          "reason": "Security fix: Lodash has Prototype Pollution Vulnerability in `_.unset` and `_.omit` functions (medium)",
          "securityChecked": true,
          "securityCheckDate": "2026-02-21T00:23:12.264Z",
          "securityProvider": "github",
          "cve": "CVE-2025-13465",
          "severity": "medium",
          "url": "https://github.com/yowainwright/es-check/security/dependabot/63"
        }
      },
      "diff@5.2.2": {
        "dependents": {
          "es-check": "diff (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-02-21T00:23:12.264Z",
          "reason": "Security fix: jsdiff has a Denial of Service vulnerability in parsePatch and applyPatch (low)",
          "securityChecked": true,
          "securityCheckDate": "2026-02-21T00:23:12.264Z",
          "securityProvider": "github",
          "cve": "CVE-2026-24001",
          "severity": "low",
          "url": "https://github.com/yowainwright/es-check/security/dependabot/61"
        }
      },
      "ajv@8.18.0": {
        "dependents": {
          "es-check": "ajv (transitive dependency)"
        },
        "ledger": {
          "addedDate": "2026-02-21T09:31:35.017Z",
          "reason": "Security fix: ajv has ReDoS when using `$data` option (medium)",
          "securityChecked": true,
          "securityCheckDate": "2026-02-21T09:31:35.017Z",
          "securityProvider": "github",
          "cve": "CVE-2025-69873",
          "severity": "medium",
          "url": "https://github.com/yowainwright/es-check/security/dependabot/67"
        }
      }
    },
    "depPaths": [
      "package.json",
      "site/package.json"
    ],
    "security": {
      "enabled": true,
      "provider": "github",
      "autoFix": true,
      "interactive": false,
      "severityThreshold": "low",
      "hasWorkspaceSecurityChecks": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "pnpm run lint",
        "pnpm test"
      ],
      "after:release": "echo Successfully released ${name} v${version} to ${repo.repository}."
    }
  },
  "website": "https://jeffry.in/es-check"
}
